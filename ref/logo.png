<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Aida Chilembwe Community Technical College | 2027 Intake</title>
    <meta
      name="description"
      content="Apply to Aida Chilembwe Community Technical College for the 2027 Intake. Explore technical and vocational programmes and begin your journey toward practical skills and career development."
    />
    <meta
      name="keywords"
      content="Aida Chilembwe Community Technical College, 2027 intake, technical college Malawi, vocational training, ICT, electrical installation, welding, carpentry, plumbing, automobile mechanics, Chiradzulu"
    />
    <meta name="author" content="Aida Chilembwe Community Technical College" />
    <meta name="theme-color" content="#0B1F3A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="AidaLink" />
    <link rel="apple-touch-icon" href="./apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="./icon.svg" />
    <link rel="canonical" href="https://www.aidachilembwectc.ac.mw/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aida Chilembwe Community Technical College" />
    <meta property="og:title" content="Aida Chilembwe Community Technical College | 2027 Intake" />
    <meta
      property="og:description"
      content="Applications for the 2027 Intake are now open. Explore technical and vocational programmes and begin your journey toward practical skills and career development."
    />
    <meta property="og:url" content="https://www.aidachilembwectc.ac.mw/" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Aida Chilembwe Community Technical College | 2027 Intake" />
    <meta
      name="twitter:description"
      content="Apply now for the 2027 Intake. Build practical skills and prepare for a better future."
    />

