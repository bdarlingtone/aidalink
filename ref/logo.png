ding; learners secure independent rental accommodations in the vibrant PIM community.","The student welfare desk provides an updated advisory list of vetted community houses and local landlords near PIM.","New students are advised to confirm their rental accommodations before the first day of workshop orientation."]},{id:"workshop-ppe-standards",title:"Mandatory Workshop Safety Gear & PPE Orientation",date:"04 January 2026",category:"Academics",summary:"In accordance with occupational health and safety regulations, all students admitted into mechanical, construction, and electrical trades must obtain approved protective gear prior to practical sessions.",details:["Welding & Fabrication: Approved welding helmet, leather apron, and steel-toe safety boots.","Electrical & Electronics: Anti-static lab coat and insulated safety shoes.","Automobile & Construction: Heavy-duty workshop overalls and protective eyewear."]}];function X0(){const[s,u]=w.useState("All"),[c,o]=w.useState(""),[m,g]=w.useState("intake-2027-open"),h=["All","Admissions","Examinations","Academics","Campus Life"],f=w.useMemo(()=>Q0.filter(p=>{const b=s==="All"||p.category===s,j=c.trim()===""||p.title.toLowerCase().includes(c.toLowerCase())||p.summary.toLowerCase().includes(c.toLowerCase());return b&&j}),[s,c]);return n.jsxs("main",{className:"min-h-screen bg-[#f8fafc] pb-32 sm:pb-24 pt-20 overflow-x-hidden",children:[n.jsxs("section",{className:"relative isolate overflow-hidden bg-[var(--primary)] py-16 sm:py-24",children:[n.jsx("div",{className:"absolute inset-0 -z-10 bg-gradient-to-br from-[var(--primary)] via-[#10427c] to-[var(--primary-blue)]"}),n.jsx("div",{className:"blob left-[-8rem] top-[-4rem] h-72 w-72 bg-sky/30","aria-hidden":"true"}),n.jsx("div",{className:"blob right-[-8rem] bottom-[-6rem] h-80 w-80 bg-accent/40","aria-hidden":"true"}),n.jsx("div",{className:"container-site relative",children:n.jsxs("div",{className:"mx-auto max-w-3xl text-center",children:[n.jsxs("p",{className:"inline-flex