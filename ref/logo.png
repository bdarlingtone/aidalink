utomobile Mechanics are offered on both Government Sponsored (MK 50,000 per term) and Parallel Sponsored (MK 150,000 per term) streams. Automobile Mechanics is offered on the Parallel stream only (MK 150,000 per term). New students also pay a one-off Enrolment Registration fee of MK 10,000 and a one-off Students Union fee of MK 5,000 into the corresponding FDH Bank Chiradzulu account."},{id:"tools",category:"Campus Life",question:"Does the college supply workshop tools and safety gear?",answer:"All primary workshop equipment, machinery, testing bays, and instructional materials are provided by the college. Students receive an orientation on required personal protective equipment (such as safety boots, overalls, or laboratory coats) upon admission."}];function V0(){const[s,u]=w.useState("requirements"),[c,o]=w.useState("All"),m=["All","Admissions","Academics","Campus Life"],g=c==="All"?Lh:Lh.filter(f=>f.category===c),h=f=>{u(p=>p===f?null:f)};return n.jsx("section",{id:"faq",className:"relative py-20 sm:py-28 bg-[#f8fafc] border-t border-line",children:n.jsxs("div",{className:"container-site",children:[n.jsx(Ea,{eyebrow:"Got Questions?",title:"Frequently Asked Questions",subtitle:"Everything you need to know about the 2027 intake, qualifications, campus facilities, and admissions."}),n.jsx("div",{className:"reveal mx-auto mb-10 flex flex-wrap justify-center gap-2",children:m.map(f=>n.jsx("button",{type:"button",onClick:()=>o(f),className:`rounded-xl px-4 py-2 text-xs font-semibold transition-all duration-200 cursor-pointer ${c===f?"bg-[var(--primary)] text-white shadow-sm font-bold":"bg-white text-muted hover:text-[var(--primary)] hover:bg-slate-100 border border-line"}`,children:f},f))}),n.jsx("div",{className:"reveal mx-auto max-w-3xl space-y-3.5",children:g.map(f=>{const p=s===f.id;return n.jsxs("div",{className:`overflow-hidden rounded-2xl border transition-all duration-200 ${p?"border-accent/40 bg-white shadow-md ring-1 ring-accent/10":"border-line bg-white hove